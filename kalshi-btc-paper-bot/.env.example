# Kalshi BTC 15-minute PAPER trading bot - example configuration.
# setup.ps1 copies this file to .env. NO SECRETS ARE NEEDED: the bot only reads Kalshi's
# public market-data endpoints and never authenticates or places real orders.
# Strategy settings (limit price, contracts per side, eligible minutes, display timezone,
# fee model, starting balance) are edited in the dashboard (Settings) and stored in the database.

# live = real Kalshi production market data; preview = clearly labeled synthetic sample data
# (start.ps1 sets this from its -Preview switch)
KBOT_MODE=live

# Bind to this computer only. Changing the host exposes the dashboard to your network.
KBOT_HOST=127.0.0.1
# start.ps1 -Port overrides this
KBOT_PORT=8000

# Where the SQLite databases, engine lock and logs live (relative to the project folder)
KBOT_DATA_DIR=data
KBOT_LOG_LEVEL=INFO

# Kalshi production REST API (public market data). The fallback host is tried on connection errors.
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_FALLBACK_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_SERIES_TICKER=KXBTC15M

# Polling (well below Kalshi's basic-tier read limits) and freshness rules
KBOT_ORDERBOOK_POLL_SECONDS=2
KBOT_MARKET_POLL_SECONDS=5
KBOT_SETTLEMENT_POLL_SECONDS=20
KBOT_HTTP_TIMEOUT_SECONDS=8
# An order-book observation older than this never produces a fill
KBOT_STALE_AFTER_SECONDS=6
# Simulated order latency: liquidity seen at time T is re-checked on a fresh book >= T + delay
KBOT_EXECUTION_DELAY_SECONDS=2
# Max lateness after a window starts (covers market-discovery delays). Later = window skipped.
KBOT_ENTRY_GRACE_SECONDS=30

# Used only when the very first paper account is created (later resets use the dashboard setting)
KBOT_STARTING_BALANCE=1000

# net_on_fill (default, mirrors Kalshi's single signed position per market: each UP+DOWN pair
# is credited $1.00 once, when it forms) or hold_to_settlement (pairs paid at settlement).
# Both credit each pair exactly once and give identical final P&L.
KBOT_PAIR_ACCOUNTING=net_on_fill
